# Copy to .env to override. All values are optional.
WEB_PORT=8080
API_PORT=8001               # host port for the backend API (8000 inside the container)
MODEL_DIR=./models
ATTN_IMPLEMENTATION=sdpa     # sdpa | eager | flash_attention_2 (needs flash-attn installed)
MAX_UPLOAD_MB=200
MAX_AUDIO_SECONDS=1800
LOG_LEVEL=INFO
